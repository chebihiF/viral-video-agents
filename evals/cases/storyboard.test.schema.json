{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schéma de TEST minimal du storyboard (remplacé par contracts/storyboard.schema.json, ticket #31)",
  "type": "object",
  "required": ["compris_fr", "recap_darija", "plans"],
  "properties": {
    "compris_fr": {"type": "string", "minLength": 1},
    "recap_darija": {"type": "string", "minLength": 1},
    "plans": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["image_prompt", "motion_prompt", "narration_fr"],
        "properties": {
          "image_prompt": {"type": "string", "minLength": 1},
          "motion_prompt": {"type": "string", "minLength": 1},
          "narration_fr": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
